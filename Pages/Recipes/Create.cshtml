@page
@model RecipeApp.Pages.Recipes.CreateModel
@{
    ViewData["Title"] = "Create Recipe";
}

<h2>@ViewData["Title"]</h2>
<hr />
<form method="post" enctype="multipart/form-data" class="form-horizontal" id="recipeForm">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <partial name="_EditRecipePartial" for="Input" />
    <partial name="_IngredientsEditor" for="Input" />

    <div class="form-group mt-3">
        <div class="col-md-offset-2 col-md-10">
            <button type="button" class="btn btn-success" id="addIngredient">Add ingredient</button>
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-page="/Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/recipe-form.js" asp-append-version="true"></script>
}
