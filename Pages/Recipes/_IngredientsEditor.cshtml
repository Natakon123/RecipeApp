@using RecipeApp.Models
@model EditRecipeBase
@{
    // Prefix is "Input" when rendered with <partial for="Input" />
    var prefix = ViewData.TemplateInfo.HtmlFieldPrefix;
}

<h5 class="mt-3">Ingredients</h5>
<p class="text-muted small mb-1">
    Quantities are for the number of servings above. Nutrition columns are optional
    (total for that ingredient) and are used to calculate nutrition per serving.
</p>
<div class="table-responsive">
    <table class="table table-striped table-sm" id="ingredients" data-prefix="@prefix">
        <thead>
            <tr>
                <th>Ingredient</th>
                <th>Quantity</th>
                <th>Unit</th>
                <th>kcal</th>
                <th>Protein (g)</th>
                <th>Carbs (g)</th>
                <th>Fat (g)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Ingredients.Count; i++)
            {
                <tr>
                    <td>
                        <input asp-for="Ingredients[i].Name" class="form-control form-control-sm" />
                        <span asp-validation-for="Ingredients[i].Name" class="text-danger"></span>
                    </td>
                    <td>
                        <input asp-for="Ingredients[i].Quantity" type="number" step="any" min="0" class="form-control form-control-sm" />
                        <span asp-validation-for="Ingredients[i].Quantity" class="text-danger"></span>
                    </td>
                    <td>
                        <input asp-for="Ingredients[i].Unit" class="form-control form-control-sm" />
                        <span asp-validation-for="Ingredients[i].Unit" class="text-danger"></span>
                    </td>
                    <td><input asp-for="Ingredients[i].Calories" type="number" step="any" min="0" class="form-control form-control-sm" /></td>
                    <td><input asp-for="Ingredients[i].Protein" type="number" step="any" min="0" class="form-control form-control-sm" /></td>
                    <td><input asp-for="Ingredients[i].Carbs" type="number" step="any" min="0" class="form-control form-control-sm" /></td>
                    <td><input asp-for="Ingredients[i].Fat" type="number" step="any" min="0" class="form-control form-control-sm" /></td>
                    <td><a href="#" class="remove text-danger">Remove</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* Row template cloned by recipe-form.js; __i__ is replaced by the row index *@
<template id="ingredient-template">
    <tr>
        <td><input name="@(prefix).__i__.Name" class="form-control form-control-sm" /></td>
        <td><input name="@(prefix).__i__.Quantity" type="number" step="any" min="0" class="form-control form-control-sm" /></td>
        <td><input name="@(prefix).__i__.Unit" class="form-control form-control-sm" /></td>
        <td><input name="@(prefix).__i__.Calories" type="number" step="any" min="0" class="form-control form-control-sm" /></td>
        <td><input name="@(prefix).__i__.Protein" type="number" step="any" min="0" class="form-control form-control-sm" /></td>
        <td><input name="@(prefix).__i__.Carbs" type="number" step="any" min="0" class="form-control form-control-sm" /></td>
        <td><input name="@(prefix).__i__.Fat" type="number" step="any" min="0" class="form-control form-control-sm" /></td>
        <td><a href="#" class="remove text-danger">Remove</a></td>
    </tr>
</template>
