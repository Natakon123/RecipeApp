<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RecipeApp</title>
    
    <!-- Google Fonts & Font Awesome Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Bootstrap & Site Styles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8f9fa;
            color: #2b2d42;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .navbar-custom {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            padding: 0.8rem 0;
            transition: all 0.3s ease;
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.4rem;
            color: #ff5a5f !important;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .nav-link {
            font-weight: 500;
            color: #4a5568 !important;
            padding: 0.5rem 1rem !important;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .nav-link:hover {
            color: #ff5a5f !important;
            background-color: rgba(255, 90, 95, 0.08);
        }

        .main-container {
            flex: 1;
            padding-top: 1.5rem;
            padding-bottom: 3rem;
        }

        .footer-custom {
            background-color: #ffffff;
            border-top: 1px solid #edf2f7;
            padding: 1.5rem 0;
            font-size: 0.9rem;
            color: #718096;
            margin-top: auto;
        }

        .footer-custom a {
            color: #ff5a5f;
            text-decoration: none;
            font-weight: 500;
        }

        .footer-custom a:hover {
            text-decoration: underline;
        }

        /* ----------------------------------------------------
           CSS สำหรับบังคับให้ฟอร์ม Identity กลายเป็นการ์ดสีส้มตรงกลาง
           ---------------------------------------------------- */
        .identity-card-box {
            max-width: 420px !important;
            margin: 2rem auto !important;
            background: #ffffff !important;
            padding: 2.5rem 2rem !important;
            border-radius: 1rem !important;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08) !important;
            border: 1px solid #eaedf0 !important;
            float: none !important;
        }

        .identity-card-box h1, 
        .identity-card-box h2 {
            text-align: center !important;
            font-weight: 700 !important;
            color: #2b2d42 !important;
            font-size: 1.75rem !important;
        }

        .identity-card-box hr {
            display: none !important;
        }

        .identity-card-box button[type="submit"] {
            background-color: #ff5a5f !important;
            border-color: #ff5a5f !important;
            color: #ffffff !important;
            width: 100% !important;
            padding: 0.75rem !important;
            font-weight: 600 !important;
            border-radius: 0.5rem !important;
            margin-top: 0.75rem !important;
            box-shadow: 0 4px 12px rgba(255, 90, 95, 0.25) !important;
        }

        .identity-card-box button[type="submit"]:hover {
            background-color: #e0484c !important;
            border-color: #e0484c !important;
        }

        .identity-card-box a {
            color: #ff5a5f !important;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light navbar-custom sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <i class="fa-solid fa-utensils"></i> RecipeApp
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">
                                <i class="fa-solid fa-house me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Recipes/Index">
                                <i class="fa-solid fa-book-open me-1"></i> Recipes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Privacy">
                                <i class="fa-solid fa-shield-halved me-1"></i> Privacy
                            </a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container main-container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <div>
                &copy; 2026 <strong>RecipeApp</strong> (Natakon Wongnikom 671410014). All rights reserved.
            </div>
            <div>
                <a asp-area="" asp-page="/Privacy">Privacy Policy</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- สคริปต์สแกนเปลี่ยน Layout ของ Login/Register เป็นการ์ดให้อัตโนมัติ -->
    <script>
        (function () {
            function reformatIdentityPage() {
                var forms = document.querySelectorAll('main form');
                forms.forEach(function (form) {
                    var row = form.closest('.row');
                    if (row) {
                        row.classList.add('identity-card-box');
                        
                        // ขยายฝั่งฟอร์มให้อยู่เต็มการ์ด
                        var parentDiv = form.parentElement;
                        if (parentDiv) {
                            parentDiv.className = 'col-12';
                        }

                        // ซ่อนฝั่งขวา (Use another service to log in)
                        var siblings = Array.from(row.children);
                        siblings.forEach(function (child) {
                            if (child !== parentDiv) {
                                child.style.display = 'none';
                            }
                        });
                    }
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', reformatIdentityPage);
            } else {
                reformatIdentityPage();
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>