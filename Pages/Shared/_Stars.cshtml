@model double
@{
    var full = (int)Math.Round(Model, MidpointRounding.AwayFromZero);
}
<span class="stars" title="@Model.ToString("0.0") / 5" aria-label="@Model.ToString("0.0") out of 5 stars">@(new string('★', Math.Clamp(full, 0, 5)))<span class="stars-empty">@(new string('★', 5 - Math.Clamp(full, 0, 5)))</span></span>
