@page
@model Microsoft.AspNetCore.Identity.UI.Services.IEmailSender // หรือ Model ที่สร้างขึ้น
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center align-items-center my-5">
    <div class="col-md-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-body p-4 p-sm-5">
                <div class="text-center mb-4">
                    <div class="badge bg-danger-subtle text-danger p-3 rounded-circle mb-3">
                        <i class="fa-solid fa-user-plus fa-2x"></i>
                    </div>
                    <h3 class="fw-bold text-dark">Create Account</h3>
                    <p class="text-muted small">Join RecipeApp to manage your recipes</p>
                </div>

                <form id="registerForm" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input name="Input.Email" type="email" class="form-control rounded-3" id="emailInput" placeholder="name@example.com" required />
                        <label for="emailInput"><i class="fa-regular fa-envelope me-2"></i>Email address</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input name="Input.Password" type="password" class="form-control rounded-3" id="passwordInput" placeholder="Password" required />
                        <label for="passwordInput"><i class="fa-solid fa-lock me-2"></i>Password</label>
                    </div>

                    <div class="form-floating mb-4">
                        <input name="Input.ConfirmPassword" type="password" class="form-control rounded-3" id="confirmPasswordInput" placeholder="Confirm Password" required />
                        <label for="confirmPasswordInput"><i class="fa-solid fa-shield-halved me-2"></i>Confirm Password</label>
                    </div>

                    <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary rounded-3 fw-semibold shadow-sm" style="background-color: #ff5a5f; border: none;">
                        Sign Up
                    </button>

                    <div class="text-center mt-4">
                        <span class="text-muted small">Already have an account?</span>
                        <a asp-page="./Login" class="text-decoration-none fw-semibold ms-1" style="color: #ff5a5f;">Sign In</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>